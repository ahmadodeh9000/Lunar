// Not a standalone script: run it with
//     sh examples/minecraft/run_tests.sh [path to lunar]
// which places these tests inside minecraft.lunar's game(), where its functions live.

// ---------- tests, placed inside game() by run_tests.sh ----------

fn check(name, ok) {
    if (!ok) print "FAIL " + name;
}

fn clear_world() {
    for (let i = 0; i < len(world); i = i + 1) world[i] = AIR;
}

fn set_floor(y) {
    for (let z = 0; z < SZ; z = z + 1) {
        for (let x = 0; x < SX; x = x + 1) set_block(x, y, z, STONE);
    }
}

fn run_steps(n, forward, strafe, jump) {
    for (let i = 0; i < n; i = i + 1) step_player(1 / 60, forward, strafe, jump);
}

fn place_player(x, y, z) {
    px = x; py = y; pz = z;
    vel_y = 0;
    on_ground = false;
}

fn test_physics() {
    clear_world();
    set_floor(0);
    yaw = 0;   // facing -z

    place_player(10.5, 5, 10.5);
    run_steps(120, 0, 0, false);
    check("lands on the floor", on_ground && abs(py - 1) < 0.01);

    let ground = py;
    let peak = py;
    step_player(1 / 60, 0, 0, true);
    check("jump leaves the ground", !on_ground && vel_y > 0);
    for (let i = 0; i < 60; i = i + 1) { step_player(1 / 60, 0, 0, false); peak = max(peak, py); }
    check("jump clears one block, not two", peak - ground > 1 && peak - ground < 2);
    check("comes back down", on_ground);

    let z0 = pz;
    run_steps(60, 1, 0, false);
    check("w moves toward -z at walking speed", abs((z0 - pz) - WALK_SPEED) < 0.2);

    // wall at z = 5: stops at it from the +z side
    for (let x = 0; x < SX; x = x + 1) { set_block(x, 1, 5, STONE); set_block(x, 2, 5, STONE); }
    place_player(10.5, 1.01, 7.5);
    run_steps(120, 1, 0, false);
    check("stops at a wall", abs(pz - (6 + PLAYER_HALF_WIDTH)) < 0.01);
    check("not stuck in the wall", !box_hits_world(px, py, pz));

    // walking diagonally into it still slides along x
    let x0 = px;
    yaw = 0.7;
    run_steps(30, 1, 0, false);
    check("slides along a wall", px > x0 + 0.5 && abs(pz - (6 + PLAYER_HALF_WIDTH)) < 0.01);

    // ceiling
    set_block(20, 3, 20, STONE);
    place_player(20.5, 1.01, 20.5);
    on_ground = true;
    run_steps(10, 0, 0, true);
    check("ceiling stops a jump", py + PLAYER_HEIGHT <= 3 && !box_hits_world(px, py, pz));

    // world edge
    yaw = 0;
    place_player(1.5, 1.01, 1.5);
    run_steps(120, 1, 0, false);
    check("world edge is a wall", pz >= PLAYER_HALF_WIDTH);

    yaw = 0;
    pitch = 0;
    look(0, 100000);
    check("pitch clamps looking down", pitch == -MAX_PITCH);
    pitch = 0;
}

fn test_world() {
    generate_world();
    build_all_chunks();
    let solid = 0;
    for (let i = 0; i < len(world); i = i + 1) { if (world[i] != AIR) solid = solid + 1; }
    check("world has terrain", solid > SXZ * 2);
    spawn_player();
    check("spawn is clear", !box_hits_world(px, py, pz));
    run_steps(10, 0, 0, false);
    check("spawn stands on ground", on_ground);
}

fn aim(x, y, z, new_yaw, new_pitch) {
    eye_x = x; eye_y = y; eye_z = z;
    yaw = new_yaw; pitch = new_pitch;
    update_camera();
    raycast();
}

fn count_faces(ci) { ret len(chunk_faces[ci]) / FACE_STRIDE; }

fn test_raycast() {
    clear_world();
    set_block(10, 5, 5, STONE);

    aim(10.5, 5.5, 8.5, 0, 0);          // facing -z
    check("hits the block ahead", ray_hit && hit_x == 10 && hit_y == 5 && hit_z == 5);
    check("hit the +z face", hit_dir == 4);
    check("air cell is in front", prev_x == 10 && prev_y == 5 && prev_z == 6);

    aim(10.5, 5.5, 8.5, 3.14159265, 0); // facing +z
    check("misses behind the camera", !ray_hit);

    aim(10.5, 5.5, 13.5, 0, 0);         // 8 blocks away
    check("misses beyond reach", !ray_hit);

    aim(10.5, 8.5, 5.5, 0, -1.55);      // looking almost straight down
    check("hits from above", ray_hit && hit_dir == 2 && hit_y == 5);

    aim(12.5, 5.5, 5.5, -1.5707963, 0); // facing -x
    check("hits the +x face", ray_hit && hit_dir == 0 && prev_x == 11);
}

fn test_editing() {
    clear_world();
    set_floor(0);
    set_floor(1);
    for (let i = 0; i < len(chunk_faces); i = i + 1) build_chunk(i);
    px = 20.5; py = 2.01; pz = 20.5;
    selected_block = BRICK;

    // the block at x = 7 sits on the border between chunks 0 and 1
    let before0 = count_faces(0);
    aim(7.5, 5.5, 3.5, 0, -1.55);
    check("targets the floor", ray_hit && hit_x == 7 && hit_y == 1 && hit_z == 3);
    check("place works", place_block() && get_block(7, 2, 3) == BRICK);
    check("place adds faces", count_faces(0) == before0 + 4);

    aim(7.5, 5.5, 3.5, 0, -1.55);
    let before1 = count_faces(1);
    check("break works", break_block() && get_block(7, 2, 3) == AIR);
    check("break restores faces", count_faces(0) == before0);

    // digging at the border exposes a side wall in the neighboring chunk
    aim(7.5, 5.5, 3.5, 0, -1.55);
    check("dig works", break_block() && get_block(7, 1, 3) == AIR);
    check("neighbor chunk rebuilt", count_faces(1) == before1 + 1);

    aim(7.5, 5.5, 3.5, 0, -1.55);
    check("reaches the bottom layer", ray_hit && hit_y == 0);
    check("bottom layer can't be broken", !break_block() && get_block(7, 0, 3) != AIR);

    px = 7.5; py = 1; pz = 3.5;         // stand in the hole, then try to fill it
    aim(7.5, 5.5, 3.5, 0, -1.55);
    check("can't place inside the player", !place_block());
}

fn test_near_clip() {
    update_colors(1);
    clear_world();
    set_block(10, 5, 10, STONE);
    build_chunk(floor(10 / CHUNK) + floor(10 / CHUNK) * CHUNKS_X);
    // Eye a hair off the +z face, looking along it so it crosses the near plane.
    eye_x = 10.5; eye_y = 5.5; eye_z = 11.02;
    yaw = 0.8; pitch = 0;
    update_camera();
    quad_count = 0;
    project_chunk(chunk_faces[floor(10 / CHUNK) + floor(10 / CHUNK) * CHUNKS_X]);
    check("near face still emits", quad_count > 0);
    sort_quads();
    for (let i = 0; i < quad_count * QUAD_STRIDE; i = i + VERT_STRIDE) {
        let x = verts[i];
        check("clipped vertex is finite", x == x && x > -1000000 && x < 1000000);
    }
    let seen = [];
    for (let i = 0; i < quad_count * 4; i = i + 1) push(seen, 0);
    for (let i = 0; i < quad_count * 6; i = i + 1) seen[indices[i]] = 1;
    let missing = 0;
    for (let i = 0; i < quad_count * 4; i = i + 1) { if (seen[i] == 0) missing = missing + 1; }
    check("sort writes every quad", missing == 0);
}

test_world();
init_render_buffers();
init_clip_buffers();
test_physics();
test_raycast();
test_editing();
test_near_clip();
print "game tests: done";
