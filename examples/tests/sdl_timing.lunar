// Checks that sdl_time follows the wall clock while clock() does not, and that
// blend and vsync can be toggled.
sdl_init("sdl_timing", 200, 100);
let t0 = sdl_time();
let c0 = clock();
sdl_delay(200);
let wall = sdl_time() - t0;
let cpu = clock() - c0;
if (wall < 0.19 || wall > 0.5) print "FAIL wall " + str(wall);
if (cpu > 0.1) print "FAIL cpu " + str(cpu);
if (!sdl_set_vsync(false) || !sdl_set_vsync(true)) print "FAIL vsync";
if (!sdl_set_blend(true) || !sdl_set_blend(false)) print "FAIL blend";
let threw = false;
try { sdl_set_blend(1); } catch (e) { threw = true; }       // a bad argument raises an error
if (!threw) print "FAIL bad arg";
sdl_quit();
print "sdl_timing: done";
