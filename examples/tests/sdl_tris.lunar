// Run from the repo root. Shows for 3 seconds, left to right:
//   top row: green solid triangle; red/blue checker triangle at full shade;
//            the same at half shade.
//   bottom row: indexed batch quad with a dark right edge; untextured batch of
//            two triangles, in order, the later yellow one on top; a translucent
//            white triangle over a blue rect.
fn rgba(r, g, b, a) { ret r*16777216 + g*65536 + b*256 + a; }

fn check_bad_args(tex, W) {
    let good = [0,0,0,0,W, 9,0,1,0,W, 0,9,0,1,W];
    if (sdl_draw_tris(tex, good, 3, nil, 0) != 1) print "FAIL sequential count";
    if (sdl_draw_tris(tex, good, 3, [0,1,2], 3) != 1) print "FAIL indexed count";
    if (sdl_draw_tris(tex, good, 4, nil, 0) != nil) print "FAIL vcount too big";
    if (sdl_draw_tris(tex, good, 3, [0,1,3], 3) != nil) print "FAIL index range";
    if (sdl_draw_tris(tex, good, 3, [0,1,2], 4) != nil) print "FAIL icount too big";
    if (sdl_draw_tris(tex, good, 2, nil, 0) != nil) print "FAIL partial triangle";
    if (sdl_draw_tris(99, good, 3, nil, 0) != nil) print "FAIL bad texture";
    if (sdl_draw_tris(tex, [0,0,0,0,"x"], 1, nil, 0) != nil) print "FAIL bad element";
    if (sdl_draw_tris(tex, [0,0,0,0,-1], 1, nil, 0) != nil) print "FAIL bad color";
    if (sdl_draw_tris(tex, 5, 3, nil, 0) != nil) print "FAIL bad array";
}

sdl_init("sdl_tris", 640, 400);
let tex = sdl_load_texture("examples/tests/checker.png");
if (tex < 0) print "FAIL texture";
let W = rgba(255,255,255,255);
let D = rgba(60,60,60,255);
let quad = [230,220,0,0,W, 400,220,1,0,D, 400,380,1,1,D, 230,380,0,1,W];
let plain = [430,220,0,0,rgba(255,0,0,255), 620,220,0,0,rgba(255,0,0,255), 430,380,0,0,rgba(255,0,0,255),
             450,240,0,0,rgba(255,255,0,255), 620,380,0,0,rgba(255,255,0,255), 450,380,0,0,rgba(255,255,0,255)];

check_bad_args(tex, W);
let start = sdl_time();
let running = true;
while (running && sdl_time() - start < 3) {
    if (sdl_poll() == "quit") running = false;
    sdl_clear(30, 30, 40);
    sdl_draw_tri(20,20, 200,20, 110,190, 40,200,80,255);
    sdl_draw_tri_tex(tex, 230,20,0,0, 400,20,1,0, 315,190,0.5,1, 255);
    sdl_draw_tri_tex(tex, 430,20,0,0, 620,20,1,0, 525,190,0.5,1, 128);
    sdl_fill_rect(20, 220, 180, 160, 40, 80, 220, 255);
    sdl_set_blend(true);
    sdl_draw_tri(20,380, 200,380, 110,220, 255,255,255,128);
    sdl_set_blend(false);
    sdl_draw_tris(tex, quad, 4, [0,1,2, 0,2,3], 6);
    sdl_draw_tris(-1, plain, 6, nil, 0);
    sdl_present();
}
sdl_quit();
print "sdl_tris: done";
