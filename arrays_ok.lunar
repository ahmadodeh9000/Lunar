// Array edge cases (valid paths only).
// Every print has a trailing expected-output marker (slash-slash, equals, greater-than), in order.
// arrays_test.sh diffs real output against those markers.
// Runtime errors abort a script, so error cases live in arrays_test.sh.

// ── literals ──
let empty = [];
print empty;                        //=> []
print [1, 2, 3];                    //=> [1, 2, 3]
// trailing comma
print [1, 2, 3,];                   //=> [1, 2, 3]
print [[], []];                     //=> [[], []]
print [nil, true, false];           //=> [nil, true, false]
// strings print unquoted inside arrays
print ["a", "b"];                   //=> [a, b]
print [1 + 2, 3 * 4, 2 ** 3];       //=> [3, 12, 8]
print [1, 2, 3][1];                 //=> 2

// ── get / set ──
let a = [10, 20, 30];
print a[0];                         //=> 10
print a[2];                         //=> 30
print a[1 + 1];                     //=> 30
// integer-valued double is a valid index
print a[2.0];                       //=> 30
print a[-0];                        //=> 10
a[0] = 99;
print a;                            //=> [99, 20, 30]
// assignment is an expression
print a[1] = 5;                     //=> 5
a[0] = a[1] = 7;
print a;                            //=> [7, 7, 30]
a[2] = a[2] + 1;
print a;                            //=> [7, 7, 31]

// ── nesting ──
let m = [[1, 2], [3, 4]];
print m[1][0];                      //=> 3
m[0][1] = 20;
print m;                            //=> [[1, 20], [3, 4]]
// rows are references
let row = m[1];
row[0] = 30;
print m;                            //=> [[1, 20], [30, 4]]

// ── aliasing / equality / truthiness ──
let x = [1, 2];
let y = x;
y[0] = 100;
print x;                            //=> [100, 2]
print x == y;                       //=> true
// reference equality, not structural
print [1] == [1];                   //=> false
print x != [100, 2];                //=> true
if ([]) print "truthy";             //=> truthy

// ── precedence ──
let nums = [5, 10, 15];
print -nums[0];                     //=> -5
print !nums[0];                     //=> false
print nums[0] + nums[1] * nums[2];  //=> 155
print ["x"][0] + "y";               //=> xy

// ── functions ──
fn double(n) { ret n * 2; }
let fns = [double];
print fns[0](21);                   //=> 42

fn make() { ret [1, 2, 3]; }
print make()[2];                    //=> 3
// assignment through a call result: compiles and runs, no visible effect
make()[0] = 5;

fn fill(arr, n) {
    for (let i = 0; i < n; i = i + 1) { arr[i] = i * i; }
}
let sq = [0, 0, 0, 0];
fill(sq, 4);
print sq;                           //=> [0, 1, 4, 9]

// ── locals in a block ──
{
    let loc = [1, 2, 3];
    loc[1] = 50;
    print loc;                      //=> [1, 50, 3]
}

// ── captured by a closure (upvalue closes over an array) ──
fn make_log() {
    let log = [0];
    fn bump() { log[0] = log[0] + 1; ret log[0]; }
    ret bump;
}
let b = make_log();
b();
b();
print b();                          //=> 3

// ── array as struct field ──
struct Stack {
    init() { self.items = [nil, nil, nil]; self.top = 0; }
    push(v) { self.items[self.top] = v; self.top = self.top + 1; }
    peek() { ret self.items[self.top - 1]; }
}
let s = Stack();
s.push(1);
s.push(2);
print s.peek();                     //=> 2
print s.items;                      //=> [1, 2, nil]

// ── instances inside arrays ──
struct P { init(x) { self.x = x; } }
let ps = [P(1), P(2)];
ps[1].x = 20;
print ps[1].x;                      //=> 20
print ps[0].x;                      //=> 1

// ── loop over an array ──
let total = 0;
for (let i = 0; i < 3; i = i + 1) { total = total + nums[i]; }
print total;                        //=> 30

// ── GC stress: many short-lived arrays + strings (also run with -DLUNAR_DEBUG_STRESS_GC) ──
let big = [];
for (let i = 0; i < 20000; i = i + 1) {
    big = [i, [i], "s" + str(i)];
}
print big[0];                       //=> 19999
print big[1][0];                    //=> 19999
print big[2];                       //=> s19999

// ── natives: len / push / pop / str ──
let q = [];
print len(q);                       //=> 0
print len([1, 2, 3]);               //=> 3
print len("abc");                   //=> 3
push(q, 1);
push(q, [2, 3]);
print q;                            //=> [1, [2, 3]]
print len(q);                       //=> 2
// push returns the array itself
print push(q, "z") == q;            //=> true
print pop(q);                       //=> z
print pop(q);                       //=> [2, 3]
print pop(q);                       //=> 1
// pop on empty returns nil
print pop(q);                       //=> nil
print len(q);                       //=> 0
print str([1, "a", nil, true, [2]]);  //=> [1, a, nil, true, [2]]
print len(str([1, 2]));             //=> 6
// bad arguments return nil, like the other natives
print push(1, 2);                   //=> nil
print pop("x");                     //=> nil
print len(5);                       //=> nil
// str() on a self-containing array must terminate
let loop = [0];
loop[0] = loop;
print len(str(loop)) > 0;           //=> true

// push under GC pressure (array storage grows repeatedly)
let grow = [];
for (let i = 0; i < 5000; i = i + 1) { push(grow, [i]); }
print len(grow);                    //=> 5000
print grow[4999][0];                //=> 4999
