// At most 2048 try blocks can run at once; the 2049th is an error the 2048th catches.
fn probe() {
    try { print "probe ran"; } catch (e) { print "never"; }
}
// eight try blocks per call
fn nest(n) {
    try { try { try { try { try { try { try { try {
        if (n > 1) nest(n - 1); else probe();
    } catch (e) { print e; } } catch (e) { print e; } } catch (e) { print e; } } catch (e) { print e; }
    } catch (e) { print e; } } catch (e) { print e; } } catch (e) { print e; } } catch (e) { print e; }
}
nest(255);     // 2040 running, the probe is the 2041st
nest(256);     // 2048 running, the probe would be the 2049th

// 10000 throw/catch cycles leak no handlers and no stack slots
let caught = 0;
for (let k = 0; k < 10000; k = k + 1) {
    let a = k;
    try { let b = a; throw b; } catch (e) { caught = caught + 1; }
}
print caught;
let last = "last";
print last;
