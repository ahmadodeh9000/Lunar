let s = import("string");
print s.to_number("42");
print s.to_number("-3.5");
print s.to_number("+7");
print s.to_number("  12  ");
print s.to_number("0.25");
print s.to_number(".5");
print s.to_number("5.");
print s.to_number("1e3");
print s.to_number("2.5E-2");
print s.to_number("007");
fn bad(text) {
    try { s.to_number(text); print "no error"; } catch (e) { print e; }
}
bad("");
bad("   ");
bad("abc");
bad("12abc");
bad("1 2");
bad("0x10");
bad("inf");
bad("nan");
bad("1e");
bad("-");
bad(".");
bad("e5");
