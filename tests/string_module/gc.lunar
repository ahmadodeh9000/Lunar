// Lots of short-lived strings and arrays from the module, so collections happen
// mid-call under the GC-stress build.
let s = import("string");
let total = 0;
for (let i = 0; i < 300; i = i + 1) {
    let line = s.join(["w" + str(i), "x", "y" + str(i * 2), "z"], " ");
    let parts = s.split(line, " ");
    let up = s.upper(s.replace(line, " ", "_"));
    total = total + len(parts) + len(s.chars(s.slice(up, 0, 4))) + s.char_count(s.repeat("é", 3));
    if (s.to_number(str(i)) != i) print "to_number broke at " + str(i);
}
print total;
