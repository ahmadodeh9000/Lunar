let s = import("string");
print s.slice("hello", 1, 3);
print s.slice("hello", 0, 5);
print s.slice("hello", -3, -1);
print s.slice("hello", 2, 100);          // out-of-range ends are clamped
print "[" + s.slice("hello", 3, 1) + "]";
print "[" + s.slice("", 0, 0) + "]";
print s.upper("Hello, wörld!");          // ASCII letters only
print s.lower("HeLLo ÄB");
print "[" + s.trim(" \t hi there" + s.from_byte(13) + "\n") + "]";
print "[" + s.trim("   ") + "]";
print "[" + s.trim("nothing") + "]";
print s.repeat("ab", 3);
print "[" + s.repeat("ab", 0) + "]";
print "[" + s.repeat("", 1000000) + "]";
print s.repeat("-", 10);
