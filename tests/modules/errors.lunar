// Every import error can be caught.
fn try_import(path) {
    try { import(path); print "no error"; } catch (e) { print e; }
}
try_import("lib/nope.lunar");
try_import("lib/cycle_a.lunar");
try_import("lib/cycle_x.lunar");
try_import("lib/self.lunar");
try_import("lib/throws.lunar");
try_import("lib/throws.lunar");          // not cached after failing: it runs again
try_import("lib/bad_syntax.lunar");
try_import("lib/sub/");
try_import("strng");
try_import("utils");
try { import(5); } catch (e) { print e; }
try { import(nil); } catch (e) { print e; }
// after all that, imports still work
print import("lib/plain.lunar");
