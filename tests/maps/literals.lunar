// Map literals: key forms, duplicates, trailing comma, nesting.
print {};
print { "name": "Rex", "hp": 10 };
print { hp: 10, mp: 5 };                 // bare identifiers are string keys
print { hp: 1 } == { hp: 1 };            // by reference
let name = "dynamic";
print { (name): 1, ("a" + "b"): 2 };     // parentheses make a computed key
print { 1: "one", 2.5: "two and a half", -3: "minus three" };
print { true: "yes", false: "no" };
print { a: 1, b: 2, a: 3 };              // last value wins, first position kept
print { a: 1, b: 2, };                   // trailing comma
print { x: { y: { z: [1, 2, { w: true }] } } };
let one = { 1: "int" };
print one[1.0];                          // 1 and 1.0 are the same key
let zero = { 0: "zero" };
print zero[-0];                          // 0 and -0 are the same key
let mixed = { 1: "number", "1": "string" };
print mixed[1] + " " + mixed["1"];
print len(mixed);
let v = 5;
print { v: v, w: v * 2 };                // key "v", value of v
