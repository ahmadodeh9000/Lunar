// Maps and strings from os in a loop, so collections happen mid-call under GC stress.
let os = import("os");
let total = 0;
for (let i = 0; i < 25; i = i + 1) {
    let r = os.run("echo " + str(i) + "; echo e" + str(i) + " >&2");
    total = total + len(r.out) + len(r.err) + r.code + len(os.cwd());
    if (os.env("HOME") == nil) print "no HOME";
}
print total - 25 * len(os.cwd());
