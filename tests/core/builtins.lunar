// Built-in functions, and the errors they raise on bad arguments.
print sqrt(16);
print abs(-3);
print floor(2.7);
print ceil(2.1);
print min(2, -3);
print max(2, -3);
print pow(2, 10);
print str(42);
print str(true);
print str(nil);
print str("s");
print len("hello");
print hex("ff");
let r = random(1, 6);
print r >= 1 && r <= 6 && r == floor(r);
print random(5, 5);
print clock() >= 0;
print str(clock);
// bad arguments raise an error (before M5 they returned nil)
try { sqrt("x"); } catch (e) { print e; }
try { len(5); } catch (e) { print e; }
try { len(); } catch (e) { print e; }
try { push(1, 2); } catch (e) { print e; }
try { pop("x"); } catch (e) { print e; }
try { min(1); } catch (e) { print e; }
