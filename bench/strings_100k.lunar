// Interpolation, then split and join, on 100k short lines. Locals inside a function.
fn main() {
    let string = import("string");
    let total = 0;
    for (let i = 0; i < 100000; i = i + 1) {
        let line = "item {i}: x={i * 2} y={i + 1}";
        let parts = string.split(line, " ");
        let back = string.join(parts, ",");
        total = total + len(back) + len(parts);
    }
    ret total;
}
print main();
